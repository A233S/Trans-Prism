<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <!-- 存储/相册权限：用于保存 SVG/PNG 导出文件 -->
    <!-- Android 13+ (API 33+)：细粒度媒体权限 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <!-- Android 9- (API ≤28)：传统存储权限 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"/>
    <!-- Android 10-12 (API 29-32)：Scoped Storage，仅需读取权限 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- 用药提醒走 fullScreenIntent（AndroidNotificationDetails.fullScreenIntent=true）。
         Android 14+ (API 34+) 未声明该权限时，全屏通知会被系统静默降级为普通通知。 -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <!-- 「显示在其他应用上层」（悬浮窗）。看似与用药无关，实为小组件点击能否打开 App 的关键：
         Android 10+ 限制应用在「后台」启动 Activity（BAL），而**持有 SYSTEM_ALERT_WINDOW
         的应用在 BAL 豁免名单内**。小组件点击正是「从后台启动 Activity」，
         没有它就会出现「点小组件偶尔才能打开 App」。
         国产 ROM 也把它当「后台弹出界面」的判据（OPPO 的检测即 Settings.canDrawOverlays）。
         该权限需用户在系统设置里手动授予，App 内「我的 → 高级 → 通知权限与保活」有引导。 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <!-- 提升 Android 14+ 后台存活率 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <application
        android:label="Trans Prism"
        android:usesCleartextTraffic="true"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true">
        <!-- ⚠️ 不要给 MainActivity 加 android:taskAffinity=""（2026-09-21 移除）
             历史上这里写过 taskAffinity=""，会让 MainActivity 的 task affinity 变成空串。
             空 affinity + FLAG_ACTIVITY_NEW_TASK（小组件点击 / 通知 / 中转 Receiver 都用它）
             属于未定义地带：系统可能每次都新建一个 task，而不是把已有的 app task 拉回前台。
             在小米澎湃 OS 上表现为「点小组件偶尔才能打开 App」。
             移除后 affinity 回落到默认值（包名），launch 行为与「点桌面图标」完全一致。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Impeller 已禁用 (2026-07-22)：liquid_glass_easy v3.3.1 的 _skia.frag
             着色器使用了 #include 预处理指令，Impeller 编译器 impellerc 不兼容。
             回退到 Skia 后端以确保着色器编译正常。
             待 liquid_glass_easy 发布 Impeller 兼容版本后可重新启用。 -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />
        <!-- flutter_local_notifications 组件声明（必须由宿主 App 声明）。
             flutter_local_notifications 17.x 的插件 AndroidManifest 只声明了
             VIBRATE / POST_NOTIFICATIONS 两个权限，不再自带 Receiver；
             官方 README「Scheduled notifications」要求宿主 App 自行声明。
             缺失时：zonedSchedule() 注册闹钟成功（dumpsys alarm 可见），
             但到点系统广播无组件接收，通知永不弹出（静默失效）。
             注意 android:exported 必须为 false（与官方示例一致），设为 true
             无必要且会扩大攻击面。 -->
        <!-- 闹钟到点接收器：zonedSchedule 的 PendingIntent 目标 -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false" />
        <!-- 开机 / 应用更新后恢复已排程提醒 -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- 通知按钮（已服药 / 5分钟后提醒）动作接收器 -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver"
            android:exported="false" />

        <!-- ─── 桌面用药小组件（Glance for AppWidgets）───────────────────
             AppWidget Provider 必须 exported=true，否则 Launcher 无法投递
             APPWIDGET_UPDATE 广播，桌面也就无法添加该小组件。
             数据侧只读 Flutter 的同一份 SharedPreferences
             （drug_inventory_list / medication_logs），不新增任何存储。 -->
        <receiver
            android:name=".widget.MediumMedsWidgetReceiver"
            android:exported="true"
            android:label="@string/meds_widget_medium_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/meds_widget_medium_info" />
        </receiver>
        <!-- ─── 小组件点击的广播中转（HyperOS / 澎湃 OS 兼容）─────────────
             小组件点击不直接 PendingIntent.getActivity → MainActivity，
             而是 PendingIntent.getBroadcast → 本 Receiver → startActivity()。
             原因：HyperOS 会拦截「小组件 PendingIntent 直接启动 Activity」，
             表现是卡片显示正常但点击无反应；而应用自己进程里发起的
             startActivity()（Receiver 被唤醒时持有短暂的后台启动豁免）不受此限制。
             参考同级项目 calendar_countdown_widget 的 HyperOS 踩坑记录。

             android:exported 必须为 true：参考项目记录「中转组件若设为
             exported=false，也可能被 HyperOS 拦截」（即使 PendingIntent
             理论上不受 exported 限制）。onReceive 里严格校验 action，
             非本 action 一律忽略。 -->
        <receiver
            android:name=".widget.MedsWidgetClickReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.daanser.transprism.widget.action.CLICK" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widget.SmallMedsWidgetReceiver"
            android:exported="true"
            android:label="@string/meds_widget_small_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/meds_widget_small_info" />
        </receiver>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
