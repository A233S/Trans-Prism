<?xml version="1.0" encoding="utf-8"?>
<!--
  中尺寸用药小组件。
  尺寸按 Android 单元格公式 70*n - 30：4 列 → 250dp。
  高度默认仍按 **3 行**放置（保持既有默认观感不变）。
  真机实测（小米澎湃 OS，2026-09-21）：两格高 152dp / 三格高 221dp，一格 ≈ 69dp。
  内容自然高约 191dp，所以**手动缩到两格高时底栏会被切约 40dp**。
  现由 MedsDims.mediumVertical 按可用高度自适应：< 200dp 走紧凑档（省 48dp，能完整放下），
  ≥ 200dp 走常规档（默认三格高观感完全不变）。
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:minResizeWidth="180dp"
    android:minResizeHeight="180dp"
    android:maxResizeWidth="420dp"
    android:maxResizeHeight="360dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:previewImage="@mipmap/ic_launcher"
    android:description="@string/meds_widget_medium_description"
    android:widgetCategory="home_screen" />
